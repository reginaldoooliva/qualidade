# Banco: Postgres hospedado no Neon (https://neon.tech). Crie um projeto lá e copie a
# connection string (aba "Connection Details", com pooler e sslmode=require).
# Usado tanto via Docker Compose quanto em dev local sem Docker (ver backend/.env.local.example).
DATABASE_URL=postgresql+psycopg2://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/nomedobanco?sslmode=require&channel_binding=require

# JWT
JWT_SECRET=troque_este_segredo_em_producao
JWT_EXPIRE_MINUTES=600

# Origens (frontend) autorizadas pelo backend a fazer requisições (CORS).
# Para acessar de celular/tablet na mesma rede Wi-Fi, inclua o IP local do servidor, ex:
# CORS_ORIGINS=["http://localhost:5173","http://192.168.0.X:5173"]
CORS_ORIGINS=["http://localhost:5173"]

# Frontend
# Para acesso via celular/tablet na rede local, troque para o IP local do servidor, ex:
# VITE_API_URL=http://192.168.0.X:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1
