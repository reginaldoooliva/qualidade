# Config para rodar o backend localmente SEM Docker (uvicorn direto).
# Copie para backend/.env.local e rode: uvicorn app.main:app --reload --env-file .env.local
# Banco: Postgres hospedado no Neon (https://neon.tech) — crie um projeto e copie a
# connection string (aba "Connection Details", com pooler e sslmode=require) para baixo.
DATABASE_URL=postgresql+psycopg2://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/nomedobanco?sslmode=require&channel_binding=require
JWT_SECRET=dev-secret-nao-usar-em-producao
JWT_EXPIRE_MINUTES=600
